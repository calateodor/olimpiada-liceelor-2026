{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olimpiada-liceelor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "kv_namespaces": [
    { "binding": "OL_KV", "id": "7699a7a108b14742b4ee16508bdc2421" }
  ],
  // reacțiile cu emoji din galerie (D1 = SQLite): o cheie unică (poză, emoji, vizitator) face imposibilă dublarea
  "d1_databases": [
    { "binding": "OL_DB", "database_name": "olimpiada-reactions", "database_id": "8411adb7-1a18-4108-a460-6417e70e3df1" }
  ],
  "r2_buckets": [
    { "binding": "OL_MEDIA", "bucket_name": "olimpiada-media" }
  ],
  "vars": {},
  "observability": { "enabled": true }
}
